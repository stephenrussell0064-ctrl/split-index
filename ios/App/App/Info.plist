<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Split Index</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Answers Apple's export-compliance question up front so App Store
	     Connect stops holding each build for a manual answer before it can go
	     to TestFlight or review. "false" means no NON-exempt encryption: the
	     app ships no cryptography of its own — no CryptoKit, no CommonCrypto,
	     no bundled algorithms — and everything it does encrypt (the WebView's
	     connection to splitindex.co.uk, plus Supabase, Stripe and RevenueCat)
	     is standard HTTPS/TLS provided by iOS, which Apple exempts.
	     Revisit this if the app ever encrypts anything itself, e.g. encrypting
	     cached sessions on disk with our own key rather than relying on iOS
	     file protection. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- arm64, not armv7. armv7 is the 32-bit capability, dropped by iOS 11 —
	     Capacitor 8 targets far above that, so the old value described a device
	     this app cannot run on. -->
	<key>UIRequiredDeviceCapabilities</key>
	<!-- arm64, not armv7. armv7 is the 32-bit capability, dropped by iOS 11 —
	     Capacitor 8 targets far above that, so the old value described a device
	     this app cannot run on. -->
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Split Index uses your location to track distance and pace during a run.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Split Index tracks your run in the background so tracking keeps going even with your phone locked.</string>
	<!--
	  Two modes, both of which this app actually uses.

	  `location` for GPS recording with the screen locked, and
	  `bluetooth-central` for a chest strap or a Concept2 PM5 during that same
	  session. Without the BLE mode iOS silently stops delivering notifications
	  once the screen locks, and the run is saved with an average heart rate
	  that looks plausible and is wrong — the worst failure shape available.

	  Both are justified by functionality the app ships, which is what
	  Guideline 2.5.4 asks: it rejects a background mode declared without the
	  feature that requires it. NSBluetoothAlwaysUsageDescription below names
	  the same hardware.

	  REMOVED: `workout-processing`. It is a watchOS key (WKBackgroundModes),
	  not an iOS one — there is no valid iOS UIBackgroundModes value by that
	  name and there is no watch target in this project, so it did nothing on
	  device except sit in the manifest. A mode the platform does not even
	  recognise is the worst version of what 2.5.4 rejects: it buys nothing
	  and invites the question.
	-->
	<key>UIBackgroundModes</key>
	<!--
	  Two modes, both of which this app actually uses.

	  `location` for GPS recording with the screen locked, and
	  `bluetooth-central` for a chest strap or a Concept2 PM5 during that same
	  session. Without the BLE mode iOS silently stops delivering notifications
	  once the screen locks, and the run is saved with an average heart rate
	  that looks plausible and is wrong — the worst failure shape available.

	  Both are justified by functionality the app ships, which is what
	  Guideline 2.5.4 asks: it rejects a background mode declared without the
	  feature that requires it. NSBluetoothAlwaysUsageDescription below names
	  the same hardware.

	  DELIBERATELY NOT HERE YET: `audio`.

	  SpeechPlugin.swift reads the per-kilometre split callouts aloud, and
	  those are silenced the moment the phone locks without that third mode —
	  which is the whole of the time an athlete is actually running. It is
	  still held back, on purpose, until 1.0 (5) is approved:

	    - The callouts cannot be heard during THIS review whatever this file
	      says. The native shell loads production (capacitor.config.ts), main
	      is frozen for the review, and the JS that calls the plugin is not on
	      main. A background mode whose feature is unreachable is exactly the
	      shape Guideline 2.5.4 rejects.
	    - The app's largest structural risk is already Guideline 4.2 (a
	      reviewer's first screen is web content). Adding a third background
	      mode to the build that answers that is unpaid risk.

	  Add the single `<string>audio</string>` line below, bump the build, and
	  ship it together with the web deploy that turns the callouts on. See the
	  "After you submit" phase of docs/pre-launch/submission-runbook.html,
	  which carries the review-notes wording to go with it.
	-->
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Split Index connects to your heart rate monitor or rowing machine (Garmin, Polar, Concept2, or other standard Bluetooth devices) during a session.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Split Index reads your heart rate from Apple Health (including AirPods Pro) during a run.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Split Index starts a workout session so AirPods Pro's heart-rate sensor turns on during a run — the workout itself isn't saved to Health.</string>
	<key>NSMotionUsageDescription</key>
	<string>Split Index counts your steps during a run or walk to show your cadence.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Export compliance. The app's only cryptography is HTTPS through the OS,
	     which is exempt under the standard categories, and declaring so here
	     stops App Store Connect halting every build for the manual encryption
	     questionnaire. Revisit if anything ever ships its own crypto. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>co.uk.splitindex.app</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
