<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No com.apple.developer.applesignin here, deliberately. The app does
	     offer Sign in with Apple (Guideline 4.8), but through Apple's *web*
	     OAuth flow via Supabase in an in-app browser — see handleOAuth in
	     src/components/auth/auth-form.tsx. That path needs a Services ID
	     configured in Supabase, not an app entitlement; the entitlement is only
	     for the native AuthenticationServices sheet, which nothing here uses.
	     Adding it back breaks signing until Sign In with Apple is also enabled
	     on the App ID in the developer portal, which is why it was removed
	     rather than matched on the portal side. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.co.uk.splitindex.app</string>
	</array>
</dict>
</plist>
