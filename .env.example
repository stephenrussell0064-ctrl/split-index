# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Stripe (checkout requires STRIPE_SECRET_KEY + STRIPE_PRICE_ID)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID=price_your-premium-monthly

# Native in-app purchase (RevenueCat) — REQUIRED for the iOS/Android builds.
#
# App Store Guideline 3.1.1 means a subscription bought inside the native app
# MUST go through Apple's IAP, which this app reaches via RevenueCat. Without
# these keys `configureRevenueCat()` bails, `getOfferings()` throws, and the
# only advertised paid tier cannot be bought on a phone — Guideline 2.1(b),
# "make sure in-app purchases are complete, up-to-date and functional".
#
# NOTE THE PREFIX. These are NEXT_PUBLIC_, so they are inlined at BUILD time.
# Setting them in Vercel without triggering a redeploy changes nothing on
# device: the native app loads whatever Vercel last built.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-revenuecat-ios-key
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-revenuecat-android-key

# Map basemap tiles (CARTO).
#
# Without this every map in the app — the live GPS tracking screen and every
# route thumbnail in the logbook — renders tiles with "API KEY REQUIRED"
# watermarked across them. The anonymous endpoint still answers 200 with a
# real PNG, so nothing errors and nothing logs; it just looks broken.
#
# Get one at https://carto.com/basemaps/apikey — emailed immediately, no
# account needed. Restrict it to your domains in the CARTO dashboard: it is
# inlined into the client bundle and cannot be kept secret.
#
# NOTE THE PREFIX. NEXT_PUBLIC_ is inlined at BUILD time, so setting this in
# Vercel without a redeploy changes nothing on device.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=your-carto-basemap-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Background jobs. The Authorization header is the ONLY accepted mechanism —
# ?secret= was removed in M6 because a secret in a URL lands in access,
# proxy and error logs. Vercel Cron sends this header on its own.
#   Authorization: Bearer $CRON_SECRET
# Integration auto-sync: GET /api/integrations/sync?cron=1
# Leaderboard refresh:   GET /api/cron/leaderboard
CRON_SECRET=your-cron-secret

# Integration OAuth — add keys to enable live provider sync
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
APPLE_HEALTH_TEAM_ID=
